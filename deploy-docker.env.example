# 实例与数据。安装目录留空默认 ~/neocloud-deploy；建议自定义时填写绝对路径。
INSTALL_DIR=
COMPOSE_PROJECT_NAME=neocloud
# 相对路径以安装目录为基准。首次部署后，数据位置随实例固定。
DATA_DIR=./data

# 对外访问。放在同机反向代理后时，通常将 WEB_BIND 改为 127.0.0.1。
WEB_BIND=0.0.0.0
WEB_PORT=4180
# 可选。填浏览器访问的完整地址，例如 https://drive.example.com，不含路径。
PUBLIC_ORIGIN=

# 高级选项。HTTP 设置留空时，HTTPS 地址禁用明文登录；其余沿用本地 HTTP 部署行为。
ALLOW_INSECURE_HTTP=
# ALLOWED_ORIGINS=["https://reader.example.com"]
